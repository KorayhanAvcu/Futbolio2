@using System.Globalization
@model Futbolio.WebUI.ViewModels.Match.MatchDetailViewModel
@{
    var m = Model.Match;
    var tr = new CultureInfo("tr-TR");
    var inv = CultureInfo.InvariantCulture;
    var events = Model.Events;

    var homeName = m.HomeTeamName;
    var awayName = m.AwayTeamName;
    var played = TeamStyle.HasScore(m.Status);
    var finished = m.Status == TeamStyle.StatusCompleted;
    var hg = m.HomeScore;
    var ag = m.AwayScore;

    ViewData["Title"] = (played ? $"{homeName} {hg}-{ag} {awayName}" : $"{homeName} - {awayName}") + " | Maç Detayı";
    ViewData["BodyClass"] = "match-page";

    // İlk yarı skoru gol kayıtlarından (45. dakika ve öncesi)
    int Goals(string side, int maxMin = int.MaxValue) => events.Count(e => e.Kind == "goal" && e.Side == side && e.Minute <= maxMin);
    var hht = Goals("home", 45);
    var aht = Goals("away", 45);

    // Kayıtlı gol sayısı skorla uyuşmuyorsa bilgi notu
    var goalsMismatch = played && (Goals("home") != hg || Goals("away") != ag);

    var sides = new[]
    {
        (Side: "home", Name: homeName, Team: Model.HomeTeam),
        (Side: "away", Name: awayName, Team: Model.AwayTeam)
    };
    string NameOf(string side) => side == "home" ? homeName : awayName;
    IHtmlContent CrestOf(string side, string mod) =>
        side == "home" ? TeamStyle.Crest(Model.HomeTeam, mod, homeName) : TeamStyle.Crest(Model.AwayTeam, mod, awayName);

    string MinText(int minute) => TeamStyle.MinuteLabel(minute).TrimEnd('\'');
    string Leader(int h, int a) => h > a ? homeName + " önde" : a > h ? awayName + " önde" : "Beraberlik";
    string Pct(double h, double a, bool isHome)
    {
        var total = h + a;
        var v = total == 0 ? 50 : (isHome ? h : a) / total * 100;
        if (v <= 0) return "0%";
        if (v >= 100) return "100%";
        return "calc(" + v.ToString("0.#", inv) + "% - 2px)";
    }
    string MarkerAria(Futbolio.WebUI.ViewModels.Match.MatchEventViewModel e) => e.Kind switch
    {
        "goal" => $"{MinText(e.Minute)}. dakika, {NameOf(e.Side)} golü, {e.Player}",
        "yellow" => $"{MinText(e.Minute)}. dakika, sarı kart, {e.Player}",
        "red" => $"{MinText(e.Minute)}. dakika, kırmızı kart, {e.Player}",
        _ => $"{MinText(e.Minute)}. dakika, {NameOf(e.Side)} oyuncu değişikliği"
    };
    string MarkerTitle(Futbolio.WebUI.ViewModels.Match.MatchEventViewModel e) => e.Kind switch
    {
        "goal" => $"{TeamStyle.MinuteLabel(e.Minute)} Gol: {e.Player}",
        "yellow" => $"{TeamStyle.MinuteLabel(e.Minute)} Sarı kart: {e.Player}",
        "red" => $"{TeamStyle.MinuteLabel(e.Minute)} Kırmızı kart: {e.Player}",
        _ => $"{TeamStyle.MinuteLabel(e.Minute)} Değişiklik: {e.Player} girdi"
    };

    // Olay sayıları (İstatistikler paneli)
    int Count(string side, params string[] kinds) => events.Count(e => e.Side == side && kinds.Contains(e.Kind));
    var stats = new[]
    {
        (Label: "Gol", Home: played ? hg : 0, Away: played ? ag : 0, Muted: false),
        (Label: "Sarı kart", Home: Count("home", "yellow"), Away: Count("away", "yellow"), Muted: true),
        (Label: "Kırmızı kart", Home: Count("home", "red"), Away: Count("away", "red"), Muted: true),
        (Label: "Oyuncu değişikliği", Home: Count("home", "sub"), Away: Count("away", "sub"), Muted: true)
    };

    var city = Model.HomeTeam?.City;
    var stadium = string.IsNullOrWhiteSpace(m.Stadium) || m.Stadium == "-" ? Model.HomeTeam?.Stadium : m.Stadium;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/match-detail.css" asp-append-version="true" />
}

<!-- SVG sembolleri -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-ball" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.4l3.4 2.5-1.3 4h-4.2l-1.3-4z" fill="currentColor" /><path d="M12 3v4.4M20.5 9.3l-5.1.6M17.4 19.4l-3.3-5.5M6.6 19.4l3.3-5.5M3.5 9.3l5.1.6" fill="none" stroke="currentColor" stroke-width="1.4" /></symbol>
    <symbol id="i-swap" viewBox="0 0 24 24"><path d="M7 4v14M3.5 7.5L7 4l3.5 3.5M17 20V6M13.5 16.5L17 20l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
    <symbol id="i-stadium" viewBox="0 0 24 24"><ellipse cx="12" cy="9" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3 9v6c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9" fill="none" stroke="currentColor" stroke-width="1.8" /></symbol>
</svg>

<main class="match-shell container-xl" data-match>

    <header class="match-hero">
        <div class="hero-topbar">
            <ul class="comp-tags" aria-label="Müsabaka">
                <li class="comp-tag comp-tag--league">Serie A</li>
                <li class="comp-tag">2026/27</li>
                <li class="comp-tag"><a href="/Fixtures?hafta=@m.Week" style="color:inherit">Hafta @m.Week</a></li>
            </ul>
            <span class="status-pill">@TeamStyle.StatusText(m.Status)</span>
        </div>

        <div class="scoreboard">
            <div class="sb-team sb-team--home @(finished && hg < ag ? "is-loser" : "")">
                @CrestOf("home", "team-crest--xl")
                <div>
                    <span class="sb-team__role">Ev sahibi</span>
                    <h1 class="sb-team__name">@homeName</h1>
                    <ul class="sb-scorers" aria-label="@homeName golleri">
                        @foreach (var e in events.Where(x => x.Kind == "goal" && x.Side == "home"))
                        {
                            <li><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>@e.Player @TeamStyle.MinuteLabel(e.Minute)</li>
                        }
                    </ul>
                </div>
            </div>

            <div class="sb-score">
                @if (played)
                {
                    <p class="sb-score__value" aria-label="Skor: @homeName @hg, @awayName @ag">
                        <span class="@(finished && hg < ag ? "is-loser" : "")">@hg</span><span class="sb-score__sep" aria-hidden="true"></span><span class="@(finished && ag < hg ? "is-loser" : "")">@ag</span>
                    </p>
                    <p class="sb-score__ht">İlk yarı @hht-@aht</p>
                }
                else
                {
                    <p class="sb-score__value" aria-label="Maç henüz başlamadı"><span>-</span><span class="sb-score__sep" aria-hidden="true"></span><span>-</span></p>
                    <p class="sb-score__ht">Başlama saati @m.MatchDate.ToString("HH:mm", tr)</p>
                }
            </div>

            <div class="sb-team sb-team--away @(finished && ag < hg ? "is-loser" : "")">
                @CrestOf("away", "team-crest--xl")
                <div>
                    <span class="sb-team__role">Deplasman</span>
                    <h2 class="sb-team__name">@awayName</h2>
                    <ul class="sb-scorers" aria-label="@awayName golleri">
                        @foreach (var e in events.Where(x => x.Kind == "goal" && x.Side == "away"))
                        {
                            <li><svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>@e.Player @TeamStyle.MinuteLabel(e.Minute)</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <ul class="hero-facts">
            <li><svg aria-hidden="true"><use href="#i-calendar" /></svg>@m.MatchDate.ToString("d MMMM yyyy, dddd", tr)</li>
            <li><svg aria-hidden="true"><use href="#i-clock" /></svg>@m.MatchDate.ToString("HH:mm", tr)</li>
            @if (!string.IsNullOrWhiteSpace(stadium))
            {
                <li><svg aria-hidden="true"><use href="#i-stadium" /></svg>@stadium</li>
            }
        </ul>

        @if (events.Count > 0)
        {
            <section class="flow-strip" aria-labelledby="flow-title">
                <div class="flow-head">
                    <h2 class="flow-title" id="flow-title">Maç akışı</h2>
                    <p class="flow-hint">Ayrıntısını görmek için bir olaya dokun</p>
                </div>
                <div class="flow-scroll">
                    <div class="flow-track">
                        <span class="flow-side-label flow-side-label--home">@CrestOf("home", "team-crest--xs")</span>
                        <span class="flow-side-label flow-side-label--away">@CrestOf("away", "team-crest--xs")</span>
                        <span class="flow-axis" aria-hidden="true"></span>
                        <span class="flow-half" aria-hidden="true"><span>Devre arası</span></span>
                        @foreach (var tick in new[] { 15, 30, 45, 60, 75, 90 })
                        {
                            <span class="flow-tick" style="--x:calc(@tick / 95 * 100%)">@tick'</span>
                        }

                        @for (var i = 0; i < events.Count; i++)
                        {
                            var e = events[i];
                            // Aynı tarafta 2 dakika içinde ardışık olaylar üst üste binmesin
                            var nudge = events.Any(o => o != e && o.Side == e.Side && e.Minute - o.Minute > 0 && e.Minute - o.Minute <= 2);
                            <button type="button"
                                    class="flow-marker flow-marker--@e.Side flow-marker--@e.Group"
                                    style="--m:@Math.Min(e.Minute, 95)@(nudge ? ";margin-left:7px" : "")"
                                    data-flow-ref="ev-@i"
                                    aria-label="@MarkerAria(e)" title="@MarkerTitle(e)">
                                <span class="flow-marker__dot">
                                    @if (e.Kind == "goal")
                                    {
                                        <svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>
                                    }
                                    else if (e.Kind is "yellow" or "red")
                                    {
                                        <span class="i-card i-card--@e.Kind"></span>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                </div>
            </section>
        }
    </header>

    <div class="match-body">
        <div class="row g-4">

            <div class="col-lg-8">

                @if (goalsMismatch)
                {
                    <p class="page-note" role="note">Not: Kayıtlı gol sayısı (@Goals("home")-@Goals("away")) maç skoruyla (@hg-@ag) uyuşmuyor. Eksik gol kayıtları yönetim panelinden eklenebilir.</p>
                }

                <section class="panel" aria-labelledby="timeline-title">
                    <div class="panel__head">
                        <h2 class="panel__title" id="timeline-title">Maç olayları</h2>
                        <div class="event-filter" role="group" aria-label="Olay türüne göre filtrele">
                            <button type="button" class="chip" data-event-filter="all" aria-pressed="true">Tümü</button>
                            <button type="button" class="chip" data-event-filter="goal" aria-pressed="false">Goller</button>
                            <button type="button" class="chip" data-event-filter="card" aria-pressed="false">Kartlar</button>
                            <button type="button" class="chip" data-event-filter="sub" aria-pressed="false">Değişiklikler</button>
                        </div>
                    </div>

                    <div class="timeline-legend" aria-hidden="true">
                        <span>@CrestOf("home", "team-crest--xs")@homeName</span>
                        <span></span>
                        <span>@awayName@CrestOf("away", "team-crest--xs")</span>
                    </div>

                    @if (events.Count == 0)
                    {
                        <p class="item-empty">@(played ? "Bu maç için henüz olay kaydı girilmedi." : "Maç başladığında goller, kartlar ve değişiklikler burada görünecek.")</p>
                    }
                    else
                    {
                        <ol class="timeline">
                            <li class="event event--period"><span class="period-mark">Başlama düdüğü</span></li>

                            @{
                                var runH = 0; var runA = 0; var halfShown = false;
                            }
                            @for (var i = 0; i < events.Count; i++)
                            {
                                var e = events[i];
                                if (!halfShown && e.Minute > 45)
                                {
                                    halfShown = true;
                                    <li class="event event--period"><span class="period-mark">Devre arası <strong>@hht-@aht</strong></span></li>
                                }
                                if (e.Kind == "goal")
                                {
                                    if (e.Side == "home") { runH++; } else { runA++; }
                                }
                                <li class="event event--@e.Side event--@e.Kind" id="ev-@i" data-type="@e.Group">
                                    <span class="event__minute">@TeamStyle.MinuteLabel(e.Minute)</span>
                                    <div class="event-card">
                                        <span class="event-card__icon">
                                            @if (e.Kind == "goal")
                                            {
                                                <svg class="i-ball" aria-hidden="true"><use href="#i-ball" /></svg>
                                            }
                                            else if (e.Kind == "sub")
                                            {
                                                <svg width="18" height="18" aria-hidden="true"><use href="#i-swap" /></svg>
                                            }
                                            else
                                            {
                                                <span class="i-card i-card--@e.Kind"></span>
                                            }
                                        </span>
                                        <span class="event-card__body">
                                            @if (e.Kind == "sub")
                                            {
                                                <span class="event-card__player sub-in">@e.Player</span>
                                                <span class="event-card__meta sub-out">@e.PlayerOut</span>
                                            }
                                            else
                                            {
                                                <span class="event-card__player">@e.Player</span>
                                                <span class="event-card__meta">@(e.Kind == "goal" ? "Gol, " + NameOf(e.Side) : e.Kind == "red" ? "Kırmızı kart" : "Sarı kart")</span>
                                            }
                                        </span>
                                        @if (e.Kind == "goal")
                                        {
                                            <span class="event-score">@runH-@runA</span>
                                        }
                                    </div>
                                </li>
                            }

                            @if (finished)
                            {
                                <li class="event event--period"><span class="period-mark">Maç sonu <strong>@hg-@ag</strong></span></li>
                            }
                        </ol>
                    }
                </section>

                <section class="panel" aria-labelledby="goals-title">
                    <div class="panel__head"><h2 class="panel__title" id="goals-title">Goller</h2></div>
                    <div class="split">
                        @foreach (var t in sides)
                        {
                            var list = events.Where(e => e.Kind == "goal" && e.Side == t.Side).ToList();
                            <div class="split__col">
                                <h3 class="split__team">@CrestOf(t.Side, "team-crest--xs")@t.Name<span class="split__count">@list.Count gol</span></h3>
                                @if (list.Count == 0)
                                {
                                    <p class="item-empty">Gol yok</p>
                                }
                                else
                                {
                                    <ul class="item-list goal-list">
                                        @foreach (var e in list)
                                        {
                                            <li><span class="item-minute">@TeamStyle.MinuteLabel(e.Minute)</span><span class="item-main"><strong>@e.Player</strong></span></li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="panel" aria-labelledby="cards-title">
                    <div class="panel__head"><h2 class="panel__title" id="cards-title">Kartlar</h2></div>
                    <div class="split">
                        @foreach (var t in sides)
                        {
                            var list = events.Where(e => e.Kind is "yellow" or "red" && e.Side == t.Side).ToList();
                            <div class="split__col">
                                <h3 class="split__team">@CrestOf(t.Side, "team-crest--xs")@t.Name<span class="split__count">@list.Count kart</span></h3>
                                @if (list.Count == 0)
                                {
                                    <p class="item-empty">Kart yok</p>
                                }
                                else
                                {
                                    <ul class="item-list">
                                        @foreach (var e in list)
                                        {
                                            <li>
                                                <span class="item-minute">@TeamStyle.MinuteLabel(e.Minute)</span>
                                                <span class="item-main"><strong>@e.Player</strong></span>
                                                <span class="card-tag"><span class="i-card i-card--@e.Kind"></span>@(e.Kind == "red" ? "Kırmızı" : "Sarı")</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="panel" aria-labelledby="subs-title">
                    <div class="panel__head"><h2 class="panel__title" id="subs-title">Oyuncu değişiklikleri</h2></div>
                    <div class="split">
                        @foreach (var t in sides)
                        {
                            var list = events.Where(e => e.Kind == "sub" && e.Side == t.Side).ToList();
                            <div class="split__col">
                                <h3 class="split__team">@CrestOf(t.Side, "team-crest--xs")@t.Name<span class="split__count">@list.Count değişiklik</span></h3>
                                @if (list.Count == 0)
                                {
                                    <p class="item-empty">Değişiklik yok</p>
                                }
                                else
                                {
                                    <ul class="item-list">
                                        @foreach (var e in list)
                                        {
                                            <li><span class="item-minute">@TeamStyle.MinuteLabel(e.Minute)</span><span class="item-main"><strong class="sub-in">@e.Player</strong><small class="sub-out">@e.PlayerOut</small></span></li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </section>
            </div>

            <aside class="col-lg-4 side-col" aria-label="Maç özeti ve istatistikler">

                @if (played)
                {
                    <div class="period-cards">
                        <article class="period-card">
                            <p class="period-card__label">İlk yarı</p>
                            <p class="period-card__score">@hht-@aht</p>
                            <p class="period-card__note">@Leader(hht, aht)</p>
                        </article>
                        <article class="period-card">
                            <p class="period-card__label">İkinci yarı</p>
                            <p class="period-card__score">@(hg - hht)-@(ag - aht)</p>
                            <p class="period-card__note">@Leader(hg - hht, ag - aht)</p>
                        </article>
                        <article class="period-card period-card--final">
                            <p class="period-card__label">@(finished ? "Sonuç" : "Anlık skor")</p>
                            <p class="period-card__score">@hg-@ag</p>
                            <p class="period-card__note">@(hg == ag ? "Berabere" : (hg > ag ? homeName : awayName) + (finished ? " kazandı" : " önde"))</p>
                        </article>
                    </div>
                }

                <section class="panel" aria-labelledby="stats-title">
                    <div class="panel__head">
                        <h2 class="panel__title" id="stats-title">İstatistikler</h2>
                        <div class="stats-teams" aria-hidden="true">
                            <span>@CrestOf("home", "team-crest--xs")@homeName</span>
                            <span>@awayName@CrestOf("away", "team-crest--xs")</span>
                        </div>
                    </div>

                    <ul class="stat-list">
                        @foreach (var s in stats)
                        {
                            <li class="stat-row @(s.Muted ? "stat-row--muted" : "")">
                                <div class="stat-row__values">
                                    <span class="stat-val @(s.Home > s.Away ? "is-lead" : "")">@s.Home</span>
                                    <span class="stat-row__label">@s.Label</span>
                                    <span class="stat-val stat-val--away @(s.Away > s.Home ? "is-lead" : "")">@s.Away</span>
                                </div>
                                <div class="stat-bar" aria-hidden="true">
                                    <span class="bar-home" style="--w:@Pct(s.Home, s.Away, true)"></span>
                                    <span class="bar-away" style="--w:@Pct(s.Home, s.Away, false)"></span>
                                </div>
                            </li>
                        }
                    </ul>
                </section>

                <section class="panel" aria-labelledby="info-title">
                    <div class="panel__head"><h2 class="panel__title" id="info-title">Maç bilgileri</h2></div>
                    <dl class="info-list">
                        <div><dt>Lig</dt><dd>Serie A</dd></div>
                        <div><dt>Sezon</dt><dd>2026/27</dd></div>
                        <div><dt>Hafta</dt><dd>@m.Week</dd></div>
                        <div><dt>Durum</dt><dd>@TeamStyle.StatusText(m.Status)</dd></div>
                        @if (!string.IsNullOrWhiteSpace(stadium))
                        {
                            <div><dt>Stadyum</dt><dd>@stadium</dd></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(city))
                        {
                            <div><dt>Şehir</dt><dd>@city, İtalya</dd></div>
                        }
                        <div><dt>Tarih</dt><dd>@m.MatchDate.ToString("d MMMM yyyy", tr)</dd></div>
                        <div><dt>Saat</dt><dd>@m.MatchDate.ToString("HH:mm", tr)</dd></div>
                    </dl>
                </section>
            </aside>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/match-detail.js" asp-append-version="true"></script>
}
