@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string Current(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A1630" />

    <title>@ViewData["Title"] | Futbolio</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="site-body @ViewData["BodyClass"]">

    <header class="site-header">
        <nav class="navbar navbar-expand-lg futbolio-navbar" data-bs-theme="dark" aria-label="Ana menü">
            <div class="container-xl">

                <a class="navbar-brand futbolio-brand" asp-area="" asp-controller="Fixtures" asp-action="Index">
                    <span class="brand-icon" aria-hidden="true"><i class="bi bi-trophy-fill"></i></span>
                    <span class="brand-text">FUTBOLIO</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#futbolioNavbar"
                        aria-controls="futbolioNavbar"
                        aria-expanded="false"
                        aria-label="Menüyü aç veya kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="futbolioNavbar">
                    <ul class="navbar-nav ms-lg-auto futbolio-nav">

                        

                        <li class="nav-item">
                            <a class="nav-link @Active("Fixtures")" aria-current="@Current("Fixtures")"
                               asp-controller="Fixtures" asp-action="Index">
                                <i class="bi bi-calendar3" aria-hidden="true"></i>
                                <span>Haftalık Fikstür</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @Active("Standings")" aria-current="@Current("Standings")"
                               asp-controller="Standings" asp-action="Index">
                                <i class="bi bi-list-ol" aria-hidden="true"></i>
                                <span>Puan Durumu</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Admin">
                                <i class="bi bi-gear" aria-hidden="true"></i>
                                <span>Yönetim</span>
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
