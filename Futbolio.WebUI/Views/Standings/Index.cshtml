@using System.Globalization
@model Futbolio.WebUI.ViewModels.Standing.StandingsViewModel
@{
    ViewData["Title"] = "Serie A Puan Durumu";
    ViewData["BodyClass"] = "standings-page";

    var rows = Model?.Rows ?? new List<Futbolio.WebUI.ViewModels.Standing.StandingRowViewModel>();
    var count = rows.Count;
    var inv = CultureInfo.InvariantCulture;
    var tr = new CultureInfo("tr-TR");

    // Bölgeler takım sayısına göre: 1-4 Şampiyonlar Ligi, 5-6 Avrupa, son 3 düşme hattı
    var relFrom = count >= 10 ? count - 2 : int.MaxValue;
    string Zone(int pos) => pos <= 4 ? "ucl" : pos <= 6 ? "europe" : pos >= relFrom ? "rel" : "mid";
    string Edge(int pos) => pos == 4 ? "edge-ucl" : pos == 6 ? "edge-europe" : pos == relFrom - 1 ? "edge-rel" : "";
    string FormClass(char c) => c == 'G' ? "w" : c == 'B' ? "d" : "l";
    string FormText(char c) => c == 'G' ? "Galibiyet" : c == 'B' ? "Beraberlik" : "Mağlubiyet";
    string Gd(int v) => v > 0 ? "+" + v : v.ToString();
    string PerMatch(int goals, int played) => played == 0 ? "0" : (goals / (double)played).ToString("0.00", tr);

    // Puan dağılımı ölçeği: en düşük puanın biraz altından en yüksek puanı geçen ilk 5'in katına
    var minPts = count > 0 ? Math.Max(0, rows.Min(r => r.Standing.Points) - 1) : 0;
    var maxPts = count > 0 ? Math.Max(5, (int)Math.Ceiling((rows.Max(r => r.Standing.Points) + 1) / 5.0) * 5) : 5;
    string X(int pts) => ((pts - minPts) / (double)(maxPts - minPts) * 100).ToString("0.00", inv);
    var ticks = Enumerable.Range(1, maxPts / 5).Select(i => i * 5).Where(t => t > minPts).ToList();

    // Aynı puandaki takımlar şeritte üst üste dizilir; en kalabalık grup şerit yüksekliğini belirler
    var maxStack = count > 0 ? rows.GroupBy(r => r.Standing.Points).Max(g => g.Count()) - 1 : 0;

    var leader = count > 0 ? rows[0] : null;
    var runnerUp = count > 1 ? rows[1] : null;
    var attack = rows.OrderByDescending(r => r.Standing.GoalsFor).FirstOrDefault();
    var defence = rows.Where(r => r.Standing.Played > 0).OrderBy(r => r.Standing.GoalsAgainst).FirstOrDefault();
    var relStart = relFrom <= count ? rows[relFrom - 1] : null;
    var safe = relFrom <= count ? rows[relFrom - 2] : null;
    var formLeaders = rows.Where(r => r.Form.Length > 0)
        .OrderByDescending(r => r.FormPoints).ThenBy(r => r.Standing.Position).Take(3).ToList();

    var weekText = Model?.LastCompletedWeek > 0 ? Model.LastCompletedWeek + ". hafta sonunda" : "Henüz tamamlanan maç yok;";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/standings.css" asp-append-version="true" />
}

<main class="standings-shell container-xl" data-standings>

    <header class="standings-hero">
        <div class="hero-top">
            <div>
                <div class="hero-league"><span class="league-mark" aria-hidden="true">SA</span>İtalya, Serie A</div>
                <h1 class="hero-title">Serie A Puan Durumu</h1>
                <p class="hero-subtitle">@weekText güncel sıralama, gol dengesi ve son 5 maçlık form durumu.</p>
            </div>
            <dl class="hero-meta">
                <div><dt>Sezon</dt><dd>2026/27</dd></div>
                <div><dt>Hafta</dt><dd>@(Model?.LastCompletedWeek > 0 ? Model.LastCompletedWeek.ToString() : "-")</dd></div>
                <div><dt>Takım sayısı</dt><dd>@count</dd></div>
            </dl>
        </div>

        @if (ViewBag.Error != null)
        {
            <p class="page-note" role="alert">@ViewBag.Error</p>
        }

        @if (count > 0)
        {
            <section class="points-ladder" aria-labelledby="ladder-title">
                <div class="ladder-head">
                    <h2 class="ladder-title" id="ladder-title">Puan dağılımı</h2>
                    <p class="ladder-hint">Tabloda görmek için bir takıma dokun</p>
                </div>
                <div class="ladder-scroll">
                    <div class="ladder-track" style="--max-stack:@maxStack">
                        <span class="ladder-axis" aria-hidden="true"></span>
                        @foreach (var tick in ticks)
                        {
                            <span class="ladder-tick" style="--x:@X(tick)%">@tick</span>
                        }
                        @for (var i = 0; i < count; i++)
                        {
                            var r = rows[i];
                            var s = r.Standing;
                            var zone = Zone(s.Position);
                            var stack = rows.Take(i).Count(o => o.Standing.Points == s.Points);
                            <button type="button"
                                    class="ladder-marker @(zone == "mid" ? "" : "zone-" + zone)"
                                    style="--x:@X(s.Points)%;--stack:@stack;--i:@(count - 1 - i)"
                                    data-ladder-team="@s.TeamId" aria-pressed="false"
                                    aria-label="@s.TeamName, @s.Position. sıra, @s.Points puan" title="@s.TeamName: @s.Points puan">
                                @TeamStyle.Crest(r.Team, "team-crest--sm", s.TeamName)
                            </button>
                        }
                    </div>
                </div>
            </section>
        }
    </header>

    @if (leader != null)
    {
        <section class="summary-section" aria-label="Öne çıkanlar">
            <div class="row g-3">
                <div class="col-sm-6 col-xl-3">
                    <article class="stat-card stat-card--leader">
                        <div class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4h8v5a4 4 0 0 1-8 0V4z" /><path d="M8 6H5v1a3 3 0 0 0 3 3M16 6h3v1a3 3 0 0 1-3 3M12 13v4M9 20h6" /></svg></div>
                        <div class="stat-card__body">
                            <p class="stat-card__label">Lider</p>
                            <p class="stat-card__team">@TeamStyle.Crest(leader.Team, "team-crest--sm", leader.Standing.TeamName)@leader.Standing.TeamName</p>
                            @if (runnerUp != null)
                            {
                                <p class="stat-card__note">@runnerUp.Standing.TeamName takımının @(leader.Standing.Points - runnerUp.Standing.Points) puan önünde</p>
                            }
                        </div>
                        <p class="stat-card__value">@leader.Standing.Points<small>puan</small></p>
                    </article>
                </div>
                @if (attack != null)
                {
                    <div class="col-sm-6 col-xl-3">
                        <article class="stat-card stat-card--attack">
                            <div class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.6l3.3 2.4-1.3 3.8h-4l-1.3-3.8z" /></svg></div>
                            <div class="stat-card__body">
                                <p class="stat-card__label">En çok gol atan</p>
                                <p class="stat-card__team">@TeamStyle.Crest(attack.Team, "team-crest--sm", attack.Standing.TeamName)@attack.Standing.TeamName</p>
                                <p class="stat-card__note">Maç başına @PerMatch(attack.Standing.GoalsFor, attack.Standing.Played) gol</p>
                            </div>
                            <p class="stat-card__value">@attack.Standing.GoalsFor<small>gol</small></p>
                        </article>
                    </div>
                }
                @if (defence != null)
                {
                    <div class="col-sm-6 col-xl-3">
                        <article class="stat-card stat-card--defence">
                            <div class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" /></svg></div>
                            <div class="stat-card__body">
                                <p class="stat-card__label">En az gol yiyen</p>
                                <p class="stat-card__team">@TeamStyle.Crest(defence.Team, "team-crest--sm", defence.Standing.TeamName)@defence.Standing.TeamName</p>
                                <p class="stat-card__note">Maç başına @PerMatch(defence.Standing.GoalsAgainst, defence.Standing.Played) gol</p>
                            </div>
                            <p class="stat-card__value">@defence.Standing.GoalsAgainst<small>gol</small></p>
                        </article>
                    </div>
                }
                @if (relStart != null && safe != null)
                {
                    <div class="col-sm-6 col-xl-3">
                        <article class="stat-card stat-card--danger">
                            <div class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7l6 6 4-4 6 6M20 10v5h-5" /></svg></div>
                            <div class="stat-card__body">
                                <p class="stat-card__label">Düşme hattı başlangıcı</p>
                                <p class="stat-card__team">@TeamStyle.Crest(relStart.Team, "team-crest--sm", relStart.Standing.TeamName)@relStart.Standing.TeamName</p>
                                <p class="stat-card__note">@relStart.Standing.Points puan, kurtuluşa @(safe.Standing.Points - relStart.Standing.Points) puan</p>
                            </div>
                            <p class="stat-card__value">@(relFrom).<small>sıra</small></p>
                        </article>
                    </div>
                }
            </div>
        </section>
    }

    <div class="standings-body">
        <div class="row g-4">
            <div class="col-xl-9">

                <section class="table-panel" aria-labelledby="table-title">
                    <div class="table-toolbar">
                        <h2 class="table-toolbar__title" id="table-title">Genel sıralama</h2>
                        <div class="table-toolbar__controls">
                            <div class="zone-filter" role="group" aria-label="Bölgeye göre filtrele">
                                <button type="button" class="zone-chip zone-chip--all" data-zone-filter="all" aria-pressed="true">Tümü</button>
                                <button type="button" class="zone-chip zone-chip--ucl" data-zone-filter="ucl" aria-pressed="false">Şampiyonlar Ligi</button>
                                <button type="button" class="zone-chip zone-chip--europe" data-zone-filter="europe" aria-pressed="false">Avrupa</button>
                                <button type="button" class="zone-chip zone-chip--rel" data-zone-filter="rel" aria-pressed="false">Düşme hattı</button>
                            </div>
                            <label class="team-search">
                                <span class="visually-hidden">Takım ara</span>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4-4" /></svg>
                                <input type="search" placeholder="Takım ara" autocomplete="off" data-team-search>
                            </label>
                        </div>
                    </div>

                    <div class="standings-table-wrap">
                        <table class="standings-table">
                            <caption class="visually-hidden">Serie A 2026/27 puan durumu</caption>
                            <thead>
                                <tr>
                                    <th scope="col" class="col-pos">#</th>
                                    <th scope="col" class="col-team">Takım</th>
                                    <th scope="col" class="col-num"><abbr title="Oynanan maç">O</abbr></th>
                                    <th scope="col" class="col-num"><abbr title="Galibiyet">G</abbr></th>
                                    <th scope="col" class="col-num"><abbr title="Beraberlik">B</abbr></th>
                                    <th scope="col" class="col-num"><abbr title="Mağlubiyet">M</abbr></th>
                                    <th scope="col" class="col-num col-hide-sm"><abbr title="Atılan gol">AG</abbr></th>
                                    <th scope="col" class="col-num col-hide-sm"><abbr title="Yenilen gol">YG</abbr></th>
                                    <th scope="col" class="col-gd"><abbr title="Averaj">AV</abbr></th>
                                    <th scope="col" class="col-pts">Puan</th>
                                    <th scope="col" class="col-form">Son 5 maç</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in rows)
                                {
                                    var s = r.Standing;
                                    var zone = Zone(s.Position);
                                    var zoneClass = zone is "ucl" or "europe" or "rel" ? "zone-" + zone : "";
                                    var gdClass = s.GoalDifference > 0 ? "is-pos" : s.GoalDifference < 0 ? "is-neg" : "is-zero";
                                    var formLabel = r.Form.Length == 0
                                        ? "Henüz tamamlanan maç yok"
                                        : "Son maçlar, eskiden yeniye: " + string.Join(", ", r.Form.Select(FormText));
                                    <tr class="standings-row @zoneClass @Edge(s.Position)"
                                        data-team="@s.TeamId" data-team-name="@s.TeamName" data-zone="@zone" tabindex="0">
                                        <td class="col-pos">@s.Position</td>
                                        <th scope="row" class="col-team">
                                            <div class="team-cell">
                                                @TeamStyle.Crest(r.Team, "", s.TeamName)
                                                <span class="team-name">@s.TeamName</span>
                                            </div>
                                        </th>
                                        <td class="col-num">@s.Played</td>
                                        <td class="col-num">@s.Won</td>
                                        <td class="col-num">@s.Drawn</td>
                                        <td class="col-num">@s.Lost</td>
                                        <td class="col-num col-hide-sm">@s.GoalsFor</td>
                                        <td class="col-num col-hide-sm">@s.GoalsAgainst</td>
                                        <td class="col-gd"><span class="gd @gdClass">@Gd(s.GoalDifference)</span></td>
                                        <td class="col-pts">@s.Points</td>
                                        <td class="col-form">
                                            <ol class="form-list" aria-label="@formLabel">
                                                @foreach (var c in r.Form)
                                                {
                                                    <li><span class="form-badge form-badge--@FormClass(c)" title="@FormText(c)">@c</span></li>
                                                }
                                            </ol>
                                        </td>
                                    </tr>
                                }
                                <tr class="empty-row" data-empty-row @(count == 0 ? "" : "hidden")>
                                    <td colspan="11">
                                        @if (count == 0)
                                        {
                                            <strong>Puan durumu bulunamadı</strong>
                                            @:API'de takım kaydı yok ya da API'ye ulaşılamıyor.
                                        }
                                        else
                                        {
                                            <strong>Bu filtreyle eşleşen takım yok</strong>
                                            @:Aramayı temizle ya da “Tümü” filtresini seç.
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="table-foot">
                        <span>Gösterilen takım: <strong data-visible-count>@count</strong> / @count</span>
                        <span>@(Model?.CompletedMatchCount ?? 0) tamamlanan maçtan hesaplandı</span>
                    </div>
                </section>
            </div>

            <aside class="col-xl-3" aria-label="Tablo açıklamaları">
                <div class="side-stack">
                    <section class="side-card">
                        <h2 class="side-card__title">Renklerin anlamı</h2>
                        <ul class="legend-list">
                            <li><span class="legend-swatch" style="--swatch:var(--blue)"></span><div><strong>Şampiyonlar Ligi</strong><span>1-4. sıra</span></div></li>
                            <li><span class="legend-swatch" style="--swatch:var(--green)"></span><div><strong>Avrupa kupaları</strong><span>5-6. sıra</span></div></li>
                            @if (relFrom <= count)
                            {
                                <li><span class="legend-swatch" style="--swatch:var(--red)"></span><div><strong>Düşme hattı</strong><span>@relFrom-@count. sıra</span></div></li>
                            }
                        </ul>
                        <ul class="form-key" aria-label="Form rozetleri">
                            <li><span class="form-badge form-badge--w">G</span>Galibiyet</li>
                            <li><span class="form-badge form-badge--d">B</span>Beraberlik</li>
                            <li><span class="form-badge form-badge--l">M</span>Mağlubiyet</li>
                        </ul>
                    </section>

                    @if (formLeaders.Count > 0)
                    {
                        <section class="side-card">
                            <h2 class="side-card__title">Formda olanlar</h2>
                            <p>Son 5 maçta toplanan puan</p>
                            <ol class="form-leaders">
                                @foreach (var r in formLeaders)
                                {
                                    <li>
                                        @TeamStyle.Crest(r.Team, "team-crest--sm", r.Standing.TeamName)
                                        <span class="team-name">@r.Standing.TeamName</span>
                                        <span class="form-leaders__pts">@r.FormPoints <small>/ 15</small></span>
                                        <span class="form-meter" aria-hidden="true"><span style="--w:@((r.FormPoints * 100 / 15).ToString(inv))%"></span></span>
                                    </li>
                                }
                            </ol>
                        </section>
                    }

                    <section class="side-card note-card">
                        <h2 class="side-card__title">Sıralama notu</h2>
                        <p>Sadece tamamlanan maçlar hesaba katılır. Galibiyet 3, beraberlik 1, mağlubiyet 0 puandır.</p>
                        <p>Puan eşitliğinde averaj (atılan - yenilen gol) dikkate alınır. Averaj da eşitse atılan gol sayısına bakılır.</p>
                        <p>Son 5 maçta en sağdaki rozet en son oynanan maçtır.</p>
                    </section>
                </div>
            </aside>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/standings.js" asp-append-version="true"></script>
}
